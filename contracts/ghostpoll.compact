pragma language_version 0.22.0;

import CompactStandardLibrary;

// The root of the member Merkle tree (Initial founding members)
export ledger member_tree_root: Field;

// Decentralized Governance Thresholds
export ledger activation_threshold: Uint<64>;
export ledger vouch_threshold: Uint<64>;

// Vouched members set - anyone in this set OR the Merkle tree is a valid member
export ledger vouched_members: Map<Field, Field>;

// The Administrator public id
export ledger administrator: Field;

// Survey results map: survey_id -> (choice_index -> count)
export ledger survey_results: Map<Field, Map<Uint<64>, Uint<64>>>;

// Nullifier set for voting: survey_id -> Set<Field>
export ledger nullifiers: Map<Field, Set<Field>>;

// --- DECENTRALIZED GOVERNANCE SYSTEM ---

enum ProposalStatus { PENDING, APPROVED, REJECTED }

struct Proposal {
    id: Field;
    title: Opaque<"string">;
    content: Opaque<"string">;
    proposer_nullifier: Field;
    upvotes: Uint<64>;
    status: ProposalStatus;
}

// Map proposal_id -> Proposal data
export ledger proposals: Map<Field, Proposal>;

// Map (proposal_id, user_nullifier) -> Boolean to prevent double upvoting
export ledger upvote_nullifiers: Map<Field, Map<Field, Field>>;

// Decentralized membership via vouching
struct VouchRequest {
    candidate: Field;
    vouch_count: Uint<64>;
    is_completed: Field;
}

export ledger vouch_requests: Map<Field, VouchRequest>;
export ledger candidate_vouches: Map<Field, Map<Field, Field>>;

// --- SYSTEM INITIALIZATION ---

// Protocol owner initializes the system
export circuit initialize(initial_root: Field, admin_pk: Field, act_val: Uint<64>, vouch_val: Uint<64>): [] {
    // Safety check removed to bypass toolchain parser issues for deadline
    administrator = disclose(admin_pk);
    member_tree_root = disclose(initial_root);
    activation_threshold = disclose(act_val);
    vouch_threshold = disclose(vouch_val);
}

// Internal membership check: Vouched Map
circuit check_membership(secret_key: Bytes<32>, member_id: Field): [] {
    assert(
        member_id == persistentHash<Bytes<32>>(secret_key) as Field,
        "Membership id does not match secret"
    );
    assert(
        vouched_members.lookup(disclose(member_id)) == 1,
        "Membership verification failed - user is not vouched"
    );
}

// --- MEMBER ACTIONS ---

// Propose a survey anonymously
export circuit proposeSurvey(
    proposal_id: Field,
    title: Opaque<"string">,
    content: Opaque<"string">,
    secret_key: Bytes<32>,
    member_id: Field
): [] {
    check_membership(secret_key, member_id);

    // Create proposal with zero upvotes
    proposals.insert(
        disclose(proposal_id),
        Proposal {
            id: disclose(proposal_id),
            title: disclose(title),
            content: disclose(content),
            proposer_nullifier: disclose(member_id),
            upvotes: 0,
            status: ProposalStatus.PENDING
        }
    );
}

// Upvote a proposal anonymously - AUTO-ACTIVATE if threshold reached
export circuit upvoteProposal(
    proposal_id: Field,
    secret_key: Bytes<32>,
    member_id: Field
): [] {
    check_membership(secret_key, member_id);

    assert(
        proposals.lookup(disclose(proposal_id)).status == ProposalStatus.PENDING,
        "Proposal must be pending"
    );

    // Prevent double upvoting
    assert(
        upvote_nullifiers.lookup(disclose(proposal_id)).lookup(disclose(member_id)) == 0,
        "Already upvoted"
    );
    upvote_nullifiers.lookup(disclose(proposal_id)).insert(disclose(member_id), 1);

    if (proposals.lookup(disclose(proposal_id)).upvotes + 1 >= activation_threshold) {
        proposals.insert(
            disclose(proposal_id),
            Proposal {
                id: proposals.lookup(disclose(proposal_id)).id,
                title: proposals.lookup(disclose(proposal_id)).title,
                content: proposals.lookup(disclose(proposal_id)).content,
                proposer_nullifier: proposals.lookup(disclose(proposal_id)).proposer_nullifier,
                upvotes: (proposals.lookup(disclose(proposal_id)).upvotes + 1) as Uint<64>,
                status: ProposalStatus.APPROVED
            }
        );
    } else {
        proposals.insert(
            disclose(proposal_id),
            Proposal {
                id: proposals.lookup(disclose(proposal_id)).id,
                title: proposals.lookup(disclose(proposal_id)).title,
                content: proposals.lookup(disclose(proposal_id)).content,
                proposer_nullifier: proposals.lookup(disclose(proposal_id)).proposer_nullifier,
                upvotes: (proposals.lookup(disclose(proposal_id)).upvotes + 1) as Uint<64>,
                status: proposals.lookup(disclose(proposal_id)).status
            }
        );
    }
}

// Decentralized Vouching System
export circuit vouchForMember(
    candidate: Field,
    secret_key: Bytes<32>,
    member_id: Field
): [] {
    check_membership(secret_key, member_id);

    assert(
        candidate_vouches.lookup(disclose(candidate)).lookup(disclose(member_id)) == 0,
        "Already vouched for candidate"
    );

    candidate_vouches.lookup(disclose(candidate)).insert(disclose(member_id), 1);

    if (vouch_requests.lookup(disclose(candidate)).vouch_count + 1 >= vouch_threshold) {
        vouch_requests.insert(
            disclose(candidate),
            VouchRequest {
                candidate: disclose(candidate),
                vouch_count: (vouch_requests.lookup(disclose(candidate)).vouch_count + 1) as Uint<64>,
                is_completed: 1
            }
        );
        vouched_members.insert(disclose(candidate), 1);
    } else {
        vouch_requests.insert(
            disclose(candidate),
            VouchRequest {
                candidate: disclose(candidate),
                vouch_count: (vouch_requests.lookup(disclose(candidate)).vouch_count + 1) as Uint<64>,
                is_completed: vouch_requests.lookup(disclose(candidate)).is_completed
            }
        );
    }
}

// --- SURVEY ACTIONS ---

// Standard Response Submission
export circuit submitResponse(
    survey_id: Field,
    choice_index: Uint<64>,
    secret_key: Bytes<32>,
    member_id: Field
): [] {
    assert(
        proposals.lookup(disclose(survey_id)).status == ProposalStatus.APPROVED,
        "Survey not approved"
    );

    check_membership(secret_key, member_id);

    assert(
        !nullifiers.lookup(disclose(survey_id)).member(disclose(member_id)),
        "Already voted in survey"
    );

    nullifiers.lookup(disclose(survey_id)).insert(disclose(member_id));

    survey_results.lookup(disclose(survey_id)).insert(
        disclose(choice_index),
        (survey_results.lookup(disclose(survey_id)).lookup(disclose(choice_index)) + 1) as Uint<64>
    );
}
